{
  "name": "nexus-crm",
  "version": "1.0.0",
  "description": "Enterprise-Grade Customer Relationship and Management System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b"
  },
  "keywords": [
    "crm",
    "customer-management",
    "enterprise",
    "react",
    "typescript",
    "nodejs",
    "helpdesk",
    "billing",
    "sales-pipeline"
  ],
  "author": "NexusCRM Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5"
  }
}
