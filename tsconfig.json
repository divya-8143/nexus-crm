{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@nexus/shared/*": ["shared/src/*"],
      "@nexus/backend/*": ["backend/src/*"],
      "@nexus/frontend/*": ["frontend/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
